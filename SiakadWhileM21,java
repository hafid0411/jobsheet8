import java.util.Scanner;

public class SiakadWhileNoAbsen {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        int grade, total, i = 0;

        System.out.print("Enter the number of students: ");
        total = sc.nextInt();

        while (i < total) {
            System.out.print("Enter the grade of student " + (i + 1) + ": ");
            grade = sc.nextInt();

            if (grade < 0 || grade > 100) {
                System.out.println("Invalid grade. Re-enter a valid grade!");
                continue;
            }

            if (grade > 80 && grade <= 100) {
                System.out.println("The grade for student " + (i + 1) + " is A");
                System.out.println("Good, keep the grade!"); // Tambahan pesan untuk grade A
            } else if (grade > 73 && grade <= 80) {
                System.out.println("The grade for student " + (i + 1) + " is B+");
            } else if (grade > 65 && grade <= 73) {
                System.out.println("The grade for student " + (i + 1) + " is B");
            } else if (grade > 60 && grade <= 65) {
                System.out.println("The grade for student " + (i + 1) + " is C+");
            } else if (grade > 50 && grade <= 60) {
                System.out.println("The grade for student " + (i + 1) + " is C");
            } else if (grade > 39 && grade <= 50) {
                System.out.println("The grade for student " + (i + 1) + " is D");
            } else {
                System.out.println("The grade for student " + (i + 1) + " is E");
            }

            i++;
        }

        sc.close();
    }
}